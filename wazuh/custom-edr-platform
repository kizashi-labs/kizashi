#!/usr/bin/env python3
# Wazuh custom integration script for EDR Platform
# Deploy to: /var/ossec/integrations/custom-edr-platform
# Make executable: chmod +x /var/ossec/integrations/custom-edr-platform
# chown root:wazuh /var/ossec/integrations/custom-edr-platform

import json
import sys
import os
import urllib.request
import urllib.error

# Read alert from Wazuh
alert_file = open(sys.argv[1])
alert = json.load(alert_file)
alert_file.close()

# Configuration from ossec.conf hook_url
hook_url = sys.argv[3]  # passed as hook_url parameter

# Build payload (Wazuh standard format)
payload = json.dumps(alert).encode('utf-8')

try:
    req = urllib.request.Request(
        hook_url,
        data=payload,
        headers={'Content-Type': 'application/json'},
        method='POST'
    )
    with urllib.request.urlopen(req, timeout=10) as response:
        pass  # 200 OK expected
except urllib.error.URLError as e:
    sys.exit(1)

sys.exit(0)
