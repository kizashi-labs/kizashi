BINARY_AGENT    := agent
BINARY_WATCHDOG := watchdog
MODULE          := github.com/edr-platform/agent
LDFLAGS         := -s -w

# Version from git tag or commit
VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
LDFLAGS += -X main.version=$(VERSION)

.PHONY: all build build-linux build-linux-arm64 build-windows build-windows-arm64 build-darwin build-darwin-arm64 build-darwin-esf build-all test test-ebpf clean install-linux

all: build

# ─── Local build (host OS) ────────────────────────────────────
build:
	go build $(if $(LDFLAGS),-ldflags "$(LDFLAGS)") -o $(BINARY_AGENT)    ./cmd/agent
	go build $(if $(LDFLAGS),-ldflags "$(LDFLAGS)") -o $(BINARY_WATCHDOG) ./cmd/watchdog

# ─── Cross-compile Linux amd64 (used in Docker / CI) ─────────
build-linux:
	GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_AGENT)-linux-amd64    ./cmd/agent
	GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_WATCHDOG)-linux-amd64 ./cmd/watchdog

# ─── Cross-compile Linux arm64 (Raspberry Pi, AWS Graviton, etc.) ──────────
build-linux-arm64:
	GOOS=linux GOARCH=arm64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_AGENT)-linux-arm64    ./cmd/agent
	GOOS=linux GOARCH=arm64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_WATCHDOG)-linux-arm64 ./cmd/watchdog

# ─── Cross-compile Windows amd64 ─────────────────────────────
build-windows:
	GOOS=windows GOARCH=amd64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_AGENT)-windows-amd64.exe    ./cmd/agent
	GOOS=windows GOARCH=amd64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_WATCHDOG)-windows-amd64.exe ./cmd/watchdog

# ─── Cross-compile Windows arm64 (Surface Pro X, etc.) ───────
build-windows-arm64:
	GOOS=windows GOARCH=arm64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_AGENT)-windows-arm64.exe    ./cmd/agent
	GOOS=windows GOARCH=arm64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_WATCHDOG)-windows-arm64.exe ./cmd/watchdog

# ─── Cross-compile macOS Intel (ps polling / no ESF) ─────────
build-darwin:
	GOOS=darwin GOARCH=amd64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_AGENT)-darwin-amd64    ./cmd/agent
	GOOS=darwin GOARCH=amd64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_WATCHDOG)-darwin-amd64 ./cmd/watchdog

# ─── Cross-compile macOS Apple Silicon (M1/M2/M3) ────────────
build-darwin-arm64:
	GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_AGENT)-darwin-arm64    ./cmd/agent
	GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 \
	  go build -ldflags "$(LDFLAGS)" -o $(BINARY_WATCHDOG)-darwin-arm64 ./cmd/watchdog

# ─── Build all platforms ──────────────────────────────────────
build-all: build-linux build-linux-arm64 build-windows build-windows-arm64 build-darwin build-darwin-arm64

# ─── macOS with Endpoint Security Framework (ESF) ────────────
# 前提条件:
#   1. Apple の entitlement 承認取得済み
#   2. Developer ID 証明書でコード署名
#   3. macOS ホスト上でのネイティブビルド (CGO_ENABLED=1)
# 署名:
#   codesign --entitlements deploy/darwin/entitlements.plist \
#            --sign "Developer ID Application: Your Name" \
#            $(BINARY_AGENT)-darwin-esf
build-darwin-esf:
	CGO_ENABLED=1 GOOS=darwin GOARCH=amd64 \
	  go build -tags esf -ldflags "$(LDFLAGS)" \
	    -o $(BINARY_AGENT)-darwin-esf ./cmd/agent

# ─── Tests ───────────────────────────────────────────────────
# 走らせたついでに、走らなかった分も出します。
#
# **`ok` の行は、通った検査と走らなかった検査を区別しません。**
# server 側で同じ会計を掛けたとき、900 本が飛んだまま
# 「All tests passed!」と出ていたのが見つかりました。ここは1本
# （Windows 専用の検査）だけですが、**1本だと分かっていることと、
# 数えていないことは別です。**
#
# 上限は増減の両方で落ちます。下げないと、次に増えた分が差に隠れます。
AGENT_MAX_SKIPS ?= 1

# The `-tags ebpf` bpf2go bindings, as `<Go stem>:<.bpf.c basename>`. All five
# have their .go AND .o committed to git, which is what lets server/Dockerfile's
# agent-builder cross-compile the eBPF agent without clang.
#
# This is the single list. ci.yml calls `make generate-ebpf` rather than copying
# the bpf2go commands, because the copy is what fell behind: ProcessMonitor and
# LibraryMonitor were in neither the Makefile nor ci.yml, so editing
# process_monitor.bpf.c or library_monitor.bpf.c shipped a stale .o with CI
# green — the same failure #779 fixed for FileMonitor.
#
# The `-tags "ebpf prevention"` bindings (PreventionLSM / TamperLSM /
# CredAccessLSM / HostIntegrityMonitor / TLSMonitor) are NOT committed and are
# generated by agent-ebpf.yml; they do not belong here.
EBPF_BINDINGS := \
  ProcessMonitor:process_monitor \
  NetworkMonitor:network_monitor \
  FileMonitor:file_monitor \
  LibraryMonitor:library_monitor \
  FilelessMonitor:fileless_monitor

# generate-ebpf REGENERATES the committed bindings from the .bpf.c sources.
#
# It is not needed in order to build: a clean checkout builds with `-tags ebpf`
# as is, because all five bindings are in git. Run it after editing a .bpf.c and
# commit the result — ci.yml regenerates them too and fails the build when what
# you committed does not match.
#
# Committing the generated files is what makes the shipped agent reproducible
# from the repository. On 2026-08-12 the verification EC2 built the ebpf agent
# successfully ONLY because stale generated files from an earlier run were still
# lying in the working tree, and #779 shipped an agent whose .o predated the
# .bpf.c fix it was supposed to carry.
#
# Requires clang and a kernel with BTF (for vmlinux.h).
.PHONY: generate-ebpf
generate-ebpf: ebpf/vmlinux.h
	@cd internal/platform/linux && \
	  for spec in $(EBPF_BINDINGS); do \
	    stem=$${spec%%:*}; src=$${spec#*:}; \
	    echo "bpf2go: $$stem <- ebpf/$$src.bpf.c"; \
	    GOPACKAGE=linux go run github.com/cilium/ebpf/cmd/bpf2go \
	      -tags ebpf -cc clang -cflags "-O2 -g -target bpf -D__TARGET_ARCH_x86" \
	      $$stem ../../../ebpf/$$src.bpf.c || exit 1; \
	  done
	@echo "regenerated: $(foreach s,$(EBPF_BINDINGS),$(firstword $(subst :, ,$(s))))"
	@echo "NOTE: .go だけでなく .o も git に入っている。両方 commit すること。"
	@echo "      実際に読み込まれるのは .o で、bpf2go の .go は構造体と go:embed しか"
	@echo "      持たないため C の関数本体を変えても .go は不変（#779）。"

# vmlinux.h is gitignored and produced from the running kernel's BTF.
#
# Fails loudly when bpftool is missing. ebpf/Makefile's own rule falls back to
# `touch vmlinux.h`, which leaves an EMPTY header while printing that a
# pre-generated one is in use — the compile then fails somewhere unrelated, and
# the message sends the reader looking in the wrong place. A missing tool should
# say it is missing.
ebpf/vmlinux.h:
	@command -v bpftool >/dev/null 2>&1 || { \
	  echo "bpftool が必要です (apt-get install linux-tools-common linux-tools-$$(uname -r))" >&2; \
	  exit 1; }
	@test -r /sys/kernel/btf/vmlinux || { \
	  echo "/sys/kernel/btf/vmlinux が読めません: BTF 付きカーネルが必要です" >&2; \
	  exit 1; }
	bpftool btf dump file /sys/kernel/btf/vmlinux format c > ebpf/vmlinux.h
	@wc -l ebpf/vmlinux.h

test:
	@go test ./... -count=1 -json > /tmp/agent-test.json; status=$$?; \
	if [ $$status -ne 0 ]; then go test ./... -count=1; fi; \
	python3 ../scripts/skip_report.py --max-skips $(AGENT_MAX_SKIPS) < /tmp/agent-test.json; \
	skips=$$?; rm -f /tmp/agent-test.json; \
	if [ $$status -ne 0 ]; then exit $$status; fi; exit $$skips

# CI と同じタグで走らせます。**bpf2go の生成物が要ります**
# (`make -C ebpf` / CI の generate 手順)。無いと2パッケージが
# ビルドできず、そこにある 94 本は「飛んだ」にも「落ちた」にも
# 数えられません —— skip_report がそれを言います。
test-ebpf:
	@go test -tags ebpf ./... -count=1 -json > /tmp/agent-test-ebpf.json; status=$$?; \
	python3 ../scripts/skip_report.py --max-skips $(AGENT_MAX_SKIPS) < /tmp/agent-test-ebpf.json; \
	skips=$$?; rm -f /tmp/agent-test-ebpf.json; \
	if [ $$status -ne 0 ]; then exit $$status; fi; exit $$skips

# ─── Clean ───────────────────────────────────────────────────
clean:
	rm -f $(BINARY_AGENT) $(BINARY_WATCHDOG) \
	      $(BINARY_AGENT)-linux-amd64    $(BINARY_WATCHDOG)-linux-amd64 \
	      $(BINARY_AGENT)-linux-arm64    $(BINARY_WATCHDOG)-linux-arm64 \
	      $(BINARY_AGENT)-windows-amd64.exe $(BINARY_WATCHDOG)-windows-amd64.exe \
	      $(BINARY_AGENT)-windows-arm64.exe $(BINARY_WATCHDOG)-windows-arm64.exe \
	      $(BINARY_AGENT)-darwin-amd64   $(BINARY_WATCHDOG)-darwin-amd64 \
	      $(BINARY_AGENT)-darwin-arm64   $(BINARY_WATCHDOG)-darwin-arm64 \
	      $(BINARY_AGENT)-darwin-esf

# ─── Install on Linux host (requires root) ───────────────────
install-linux: build-linux
	@if [ "$$(id -u)" -ne 0 ]; then \
	  echo "ERROR: make install-linux はrootで実行してください"; exit 1; fi
	bash deploy/linux/install.sh
