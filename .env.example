# ═══════════════════════════════════════════════════════════════════════════════
# Kizashi — 環境変数設定例 / environment variable template
# コピーして使用: cp .env.example .env
#
# 【重要】.env は絶対にリポジトリにコミットしないこと
# 【重要】以下は必ず変更すること:
#   - POSTGRES_PASSWORD
#   - JWT_SECRET      (最低32文字のランダム文字列 / openssl rand -base64 48)
#   - ADMIN_PASSWORD  (「changeme」「admin」「password」等は起動時に拒否されます)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Security (CHANGE THESE) ──────────────────────────────────
POSTGRES_PASSWORD=
# 最低32文字。HS256 の署名鍵。生成: openssl rand -base64 48
JWT_SECRET=
# 管理者パスワード (admin / admin@localhost でのフォールバックログイン)
# 生成: openssl rand -base64 24
ADMIN_PASSWORD=
# raw_event をテナント鍵 (AES-256-GCM) で暗号化します。テナント鍵は
# tenant_encryption_keys に置かれ、この鍵でラップされます。
# 生成: openssl rand -base64 32
#
# **未設定なら暗号化は無効で、raw_event は平文で保存されます。**
# 起動ログにそう出ます（以前は黙って平文でした）。
# 設定されているのに読めない値だと、平文に落ちずに起動を拒否します。
#
TENANT_MASTER_KEY=

# ─── Ports ────────────────────────────────────────────────────
API_PORT=8080
GRPC_PORT=9090
INGESTION_PORT=9091
FRONTEND_PORT=3000
POSTGRES_PORT=5432
NATS_PORT=4222

# ─── Database ─────────────────────────────────────────────────
# DATABASE_URL: 所有者ロール edr の接続。migration(DDL)実行に使う。
DATABASE_URL=postgres://edr:password@localhost:5432/edr_platform?sslmode=disable
# APP_DATABASE_URL: アプリ実行時接続(非スーパーユーザ edr_app)。
# マルチテナント RLS 分離を実効化する。空/未設定なら DATABASE_URL にフォールバック。
#   1) migration 325 で edr_app(NOLOGIN)作成済み
#      → ALTER ROLE edr_app WITH LOGIN PASSWORD '<Secret>';
#   2) 下行を設定:
# APP_DATABASE_URL=postgres://edr_app:password@localhost:5432/edr_platform?sslmode=disable

# ─── NATS Message Bus ─────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─── Server ───────────────────────────────────────────────────
# 本番では https:// を使うこと。http:// は起動時に警告が出ます。
EDR_BASE_URL=https://edr.example.com

# WebSocket CORS 許可オリジン (カンマ区切り)。
# 未設定なら全オリジン許可（開発用）。本番では必ず設定すること。
ALLOWED_ORIGINS=

# ─── TLS (任意) ───────────────────────────────────────────────
# TLS_CERT_FILE=/certs/server.crt
# TLS_KEY_FILE=/certs/server.key

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Certificates (mTLS) ──────────────────────────────────────
CERT_DIR=./certs

# ─── Agent Deployment ─────────────────────────────────────────
SERVER_URL=http://localhost:8080
AGENT_BIN_DIR=./downloads
# Auto-update: set these after running deploy.sh --build-agent
# AGENT_LATEST_VERSION is injected automatically by deploy.sh
# AGENT_LATEST_URL example: http://your-server:8080/api/v1/agents/download?platform=linux&arch=amd64
# AGENT_LATEST_CHECKSUM is injected automatically by deploy.sh (format: sha256:<hex>)
AGENT_LATEST_VERSION=
AGENT_LATEST_URL=
AGENT_LATEST_CHECKSUM=

# ─── Response / 自動対応 ──────────────────────────────────────
# ルールベース自動隔離の発火しきい値 (1-10)。既定 9。
# 有効化する前に README の注意書きを読むこと。
AUTO_ISOLATE_MIN_SEVERITY=9
# 自動対応そのものを無効化する場合は false
AUTO_RESPONSE_ENABLED=true
# true なら隔離せず「隔離するはずだった」ことだけ response_actions に残す
# （status_text='suppressed'）。段階的に有効化するときはまずこれで件数を数える。
AUTO_ISOLATE_DRY_RUN=
# 自動隔離の除外対象（エージェントID または ホスト名、カンマ区切り）。
# 隔離はエージェントが EDR サーバ以外への通信を全遮断するため、プラットフォームを
# 動かしているホストや踏み台を隔離すると、サービス停止に加えて運用者がそのホストへ
# 入れなくなる。検知・アラートは影響を受けず、抑止されるのは応答のみ。
#   AUTO_ISOLATE_EXEMPT=edr-server,jump-host
#
# ★server と agent を同一ホストで動かす構成（検証EC2・単一ノード配備・デモ環境）では
#   自ホスト名の設定が実質必須。2026-07-02 に実際に起きている: severity-9 の
#   [SIGMA] Linux Reverse Shell で AUTO_ISOLATE が発動し、nft の
#   table inet edr_isolate が output/forward を drop して docker のブリッジ経路ごと
#   落ち、agent の offline 化と localhost:8080 の無応答が同時に起きた。server が
#   落ちているので API での unisolate が打てず、復旧はそのホスト上で
#   `sudo nft delete table inet edr_isolate` を直接叩くしかない（SSH も切れているため
#   帯域外アクセスが要る）。本番は agent/server が別ホストなので起きない。
#   「★コロケート自己隔離アウテージ」
#
#   ここに入れておけば、検知系テスト（Caldera / attack-scorer）を回すたびに
#   AUTO_ISOLATE_MIN_SEVERITY を一時的に上げ下げする必要もなくなる。
AUTO_ISOLATE_EXEMPT=
# 安全弁。空なら既定（同一端末の再隔離は 30m 間隔 / 1 時間あたり 3 台まで）。
AUTO_ISOLATE_COOLDOWN=
AUTO_ISOLATE_HOURLY_BUDGET=

# ─── Email / SMTP (任意) ──────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM=Kizashi <noreply@example.com>
DIGEST_RECIPIENTS=admin@example.com

# ─── Threat Intel Feeds (既定=有効) ───────────────────────────
# 公開 IOC ブロックリストの定期取得（6〜24時間おき）。IOC 照合の母数に
# なるため既定で有効。取得先は abuse.ch / AlienVault / CINS / blocklist.de /
# raw.githubusercontent.com(IPsum) の8本で、送るのは取得要求だけです。
# false にすると全停止します（個別に止めるなら threat_feeds.is_active）。
THREAT_FEED_SYNC_ENABLED=true

# ─── NVD CVE Lookup (既定=有効) ───────────────────────────────
# services.nvd.nist.gov への CVE 照会。エージェントが報告したソフトウェア名
# （例: openssl）だけを送ります。ホスト名・バージョン・資産IDは送りません。
# false にすると内蔵の小さな CVE 表にフォールバックします（検出数は落ちます）。
NVD_LOOKUP_ENABLED=true
# API キーを設定するとレート制限が 5→50 req/30s に緩和されます（任意）
NVD_API_KEY=

# ─── Dark Web Monitoring (任意 / 既定=無効) ───────────────────
# 有効にすると起動直後と定期実行で、次へ外向き HTTPS が出ます:
#   - raw.githubusercontent.com (joshhighet/ransomwatch)
#   - api.ransomware.live
# 自組織のテレメトリは送りませんが、通信の事実は相手先から観測されます。
# 有効化は compose オーバーレイでまとめて行うのが簡単です:
#   docker compose -f docker-compose.yml -f docker-compose.darkweb.yml up -d
DARKWEB_MONITOR_ENABLED=false
# .onion 到達性チェック用の SOCKS5 プロキシ。空なら到達性チェックはスキップ。
TOR_PROXY_URL=
# 検知時の即時通知先 (任意)
DARKWEB_ALERT_SLACK_WEBHOOK_URL=
DARKWEB_ALERT_WEBHOOK_URL=
DARKWEB_ALERT_EMAIL_TO=

# ─── Elasticsearch Log Shipping (任意) ────────────────────────
ES_URL=
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=edr-events

# ─── Backups ──────────────────────────────────────────────────
BACKUP_DIR=./backups

# ─── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=edr-api
# 開発時のみ true
ENABLE_PPROF=false
# 未設定だと alertmanager は起動時に落ちます。**わざとです。**
# 空のまま上げると、30本のアラートが評価され、発火し、どこにも
# 届かないまま終わります。それは alerting: がコメントだった頃と
# 同じ状態で、外からは「監視している」ように見えます。
ALERT_SLACK_WEBHOOK_URL=
# 任意。空なら critical も Slack だけに行きます。
ALERT_PAGERDUTY_KEY=
# Slack/PagerDuty の本文から silence 画面へ戻るための URL。
ALERT_EXTERNAL_URL=http://localhost:9093

# ─── Detection ──────────────────────────────────────────────
# GeoIP destination-country enrichment for network events (ip-api.com,
# non-blocking, cached). Requires outbound egress from the detection service;
# leave false when the server has no internet access.
GEOIP_ENRICH_ENABLED=false
# UEBA standalone anomaly-alert threshold (0-100 risk score; 0 disables).
# When >0, the detection engine raises a dedicated alert once an entity's
# accumulated behavioral risk crosses this value, independent of signature matches.
UEBA_ANOMALY_THRESHOLD=0

# ─── Threat Intel / Rule Sync (任意) ──────────────────────────
VIRUSTOTAL_API_KEY=
# GITHUB_TOKEN: PAT with `repo` (read) AND `read:packages` scopes. Used by:
#   (1) SigmaHQ rule sync,
#   (2) the system-update poller to read the private edr-platform Releases,
#   (3) the updater container's `docker compose pull` against private GHCR.
# Without this token, (1)/(2) log 404s from the Releases API and check
# stays in stub mode; (3) silently fails with `denied` from GHCR.
GITHUB_TOKEN=

# ─── Wazuh 連携 (任意) ──────────────────────────────────────────
WAZUH_MANAGER_URL=
WAZUH_USERNAME=wazuh-wui
WAZUH_PASSWORD=
WAZUH_INGEST_TOKEN=
WAZUH_SKIP_TLS=true

# ─── CSPM / AWS (任意) ────────────────────────────────────────
# AWS
#
# CSPM スキャナ (docs/CSPMスキャナ_AWS.md) が顧客ロールを AssumeRole する
# ための「引き受ける側」の身元。顧客アカウントの認証情報ではない。
# このキーには対象ロールを引き受ける権限だけを与えること。
#
# EC2 上でインスタンスロールを使う場合は 3 つとも空でよい
# (SDK が IMDS から取得する)。
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 一時credentialを使う場合のみ
AWS_SESSION_TOKEN=

# ─── Images ─────────────────────────────────────────────────
# Pinned image version pulled by docker compose. The updater container
# rewrites this on a successful auto-update so the new tag persists
# across reboots. Use a fixed semver tag in production (avoid `latest`).
IMAGE_TAG=1.0.0
